# Code

expenses = []  # list of expenses in the form of dictionary
print("Welcome to Expense tracker")
while True:
    print("= = = MENU = = =")
    print("1. Add Expense")
    print("2. view all expanse")
    print("3. View total amount")
    print("4. Exit ")

    choice = int(input("please Enter your choice:"))
    if (choice == 1):
        # Code of add expanse
        date = input("What the date:")
        catagory = input("Whats the catagory:")
        amount = float(input("Enter amount :"))
        discription = input("Expleination:")

        expense = {
            "date": date,
            "catagory": catagory,
            "discription": discription,
            "amount": amount
        }

        # add expense to list. (expenses)
        expenses.append(expense)
        print("\n Expense is added successfully")
        # next line.

    # 2. view all expenses
    elif (choice == 2):
        if (len(expenses) == 0):
            print("No Expenses")
        else:
            print("= = = Expanse = = =")
            count = 1
            for eachkarcha in expenses:
                print(f"Expense no1 {count} -> {eachkarcha['date']}, {eachkarcha['catagory']}, {eachkarcha['discription']}, {eachkarcha['amount']}")
                count += 1

    # 3. view total spending
    elif (choice == 3):
        total = 0
        for eachkarcha in expenses:
            total = total + eachkarcha["amount"]
        print("\n total Expanse = ", total)

    # 4 Exit
    elif (choice == 4):
        print(" thanks")
        break
    else:
        print(" Not valid")